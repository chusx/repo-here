#!/bin/sh
# open <file|url> — show a VM file (html, image, pdf, text...) or a URL in a new browser tab
[ $# -eq 1 ] || { echo "usage: open <file|url>" >&2; exit 2; }
case "$1" in
  *://*) printf %s "$1" > /tmp/.open-url.$$ && _outbox openurl url /tmp/.open-url.$$; rm -f /tmp/.open-url.$$ ;;
  *) [ -f "$1" ] || { echo "open: $1: not a regular file" >&2; exit 1; }
     _outbox open "$(basename -- "$1")" "$1" ;;
esac
