#!/bin/sh
# open <file|file://path|http(s)://url> — show a VM file (html, image, pdf, text...) or a URL in a browser tab
[ $# -eq 1 ] || { echo "usage: open <file|file://path|url>" >&2; exit 2; }
target=$1
case "$target" in
  file://*) target=$(printf %s "${target#file://}" | sed 's/%20/ /g') ;;
  http://*|https://*)
    tmp=$(mktemp) && printf %s "$target" > "$tmp" && _outbox openurl url "$tmp"; rc=$?; rm -f "$tmp"; exit $rc ;;
esac
[ -f "$target" ] || { echo "open: $target: not a regular file" >&2; exit 1; }
_outbox open "$(basename -- "$target")" "$target"
