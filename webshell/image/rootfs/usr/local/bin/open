#!/bin/sh
# open <file|url> — show a file (html, image, pdf, text...) or an http(s) URL in a new browser tab.
# file:///path works too and refers to your computer's files (same as /host/path).
[ $# -eq 1 ] || { echo "usage: open <file|url>" >&2; exit 2; }
case "$1" in
  http://*|https://*)
    tmp=$(mktemp) && printf %s "$1" > "$tmp" && _outbox openurl url "$tmp"; rc=$?; rm -f "$tmp"; exit $rc ;;
esac
[ -f "$1" ] || { echo "open: $1: not a regular file" >&2; exit 1; }
_outbox open "$(basename -- "$1")" "$1"
