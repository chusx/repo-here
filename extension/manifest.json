{
  "manifest_version": 3,
  "name": "Term Here",
  "version": "0.1.0",
  "description": "Open a shell on this machine in a terminal overlay on the current page.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Toggle terminal (Alt+T)" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+T" } }
  },
  "web_accessible_resources": [
    {
      "resources": ["terminal.html"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
